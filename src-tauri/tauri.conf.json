{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Code RAG",
  "version": "0.1.0",
  "identifier": "dev.local-code-rag.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && node scripts/prepare-sidecar.mjs",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Code RAG",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/rag-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
